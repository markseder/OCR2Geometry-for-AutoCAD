<Window x:Class="OCR2Geometry.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OCR2Geometry"
        Width="520"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="OCR2Geometry for AutoCAD"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,16"
                   Text="Version 0.6.0 revision 2"
                   Foreground="Gray" />

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock FontWeight="SemiBold" Text="Developer" />
            <TextBlock Margin="0,3,0,0" Text="Pavel Matveev" />
            <TextBlock Margin="0,3,0,0" Text="pavelmatveev84@gmail.com" />
            <Button Margin="0,8,0,0"
                    Width="180"
                    HorizontalAlignment="Left"
                    Content="Open GitHub project"
                    Click="OpenGitHub_Click" />
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,0,0,14" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Background="White">
                <Image Source="pack://application:,,,/OCR2Geometry;component/Resources/donate_trc20.png"
                       Width="170"
                       Height="170"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Support the project" />
                <TextBlock Margin="0,5,0,12"
                           Text="USDT — TRON (TRC20)"
                           FontWeight="SemiBold" />

                <TextBlock Text="Wallet address:" Foreground="Gray" />
                <TextBox x:Name="WalletTextBox"
                         Margin="0,4,0,8"
                         Text="TLoqWbptHqejDnj14pSQDC211xyHp1ogUq"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="1"
                         Padding="5" />

                <Button Width="130"
                        HorizontalAlignment="Left"
                        Content="Copy address"
                        Click="CopyWallet_Click" />

                <TextBlock Margin="0,14,0,0"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="Send only USDT using the TRON (TRC20) network to this address." />
            </StackPanel>
        </Grid>

        <Button Grid.Row="5"
                Width="90"
                Height="32"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True" />
    </Grid>
</Window>
