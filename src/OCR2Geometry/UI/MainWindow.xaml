<Window x:Class="OCR2Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR2Geometry for AutoCAD"
        Height="700"
        Width="1060"
        MinHeight="620"
        MinWidth="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="OCR2Geometry"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <Button Grid.Column="1"
                    Width="120"
                    Height="30"
                    Content="About / Donate"
                    Click="AboutDonate_Click" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Text="AutoCAD 2020 — local OCR v0.8.0 (no Python)"
                   Foreground="Gray" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="120" Height="32" Margin="0,0,8,0"
                        Content="Select image" Click="SelectImage_Click" />
                <Button Grid.Column="1" Width="120" Height="32" Margin="0,0,8,0"
                        Content="Paste image" Click="PasteImage_Click" />
                <TextBox Grid.Column="2" x:Name="SelectedImageTextBox" Height="28"
                         IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="3" Width="110" Height="32" Margin="0,0,8,0"
                        Content="Preview image" Click="PreviewImage_Click" IsEnabled="False" x:Name="PreviewImageButton" />
                <Button Grid.Column="4" Width="120" Height="32"
                        Content="Recognize OCR" Click="RecognizeImage_Click" IsEnabled="False" x:Name="RecognizeImageButton" />
            </Grid>

            <StackPanel Grid.Row="1">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="150" Height="32" Margin="0,0,8,0" Content="Paste coordinates" Click="PasteCoordinates_Click" />
                <Button Grid.Column="1" Width="120" Height="32" Margin="0,0,8,0" Content="Import CSV/TXT" Click="ImportTextFile_Click" />
                <Button Grid.Column="2" Width="90" Height="32" Content="Clear table" Click="ClearTable_Click" />
                <ComboBox Grid.Column="3" x:Name="OcrLayoutComboBox" Width="160" HorizontalAlignment="Left" Margin="10,0,10,0" SelectedIndex="0" ToolTip="Column order in the source image (OCR only)">
                    <ComboBoxItem Content="OCR: Point X Y Z" />
                    <ComboBoxItem Content="OCR: Point X Y" />
                    <ComboBoxItem Content="OCR: X Y Z" />
                    <ComboBoxItem Content="OCR: X Y" />
                </ComboBox>

            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <ComboBox x:Name="OcrModeComboBox" Width="170" SelectedIndex="0" Margin="0,0,8,0" ToolTip="Table cells requires a complete, straight grid around the table">
                    <ComboBoxItem Content="Mode: Auto" />
                    <ComboBoxItem Content="Mode: Table cells" />
                    <ComboBoxItem Content="Mode: Text" />
                </ComboBox>
                <Button x:Name="OcrDetailsButton" Content="OCR details" Click="OcrDetails_Click" IsEnabled="False" Padding="10,3" Margin="0,0,10,0" />
                <TextBlock x:Name="ImportStatusText" VerticalAlignment="Center" Foreground="Gray" Text="Ready" TextWrapping="Wrap" />
            </WrapPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PointsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CellEditEnding="PointsGrid_CellEditEnding">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsOcrReview}" Value="True">
                                <Setter Property="Background" Value="#FFFFF2CC" />
                                <Setter Property="ToolTip" Value="OCR result: verify Point, signs and all coordinates against the source. See OCR details for alternate readings." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Point" Binding="{Binding Number, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="85">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNumberMissing}" Value="True">
                                        <Setter Property="Background" Value="#FFFFB4A2" />
                                        <Setter Property="ToolTip" Value="Point was not recognized. Enter a whole number or use Renumber from Start." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsXRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Decimal separator restored automatically. Verify the value." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsYRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Decimal separator restored automatically. Verify the value." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Z" Binding="{Binding Z, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsZRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Decimal separator restored automatically. Verify the value." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                <Grid>
                    <Image x:Name="ImagePreview" Stretch="Uniform" Margin="8" />
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Select an image or use Win+Shift+S, then Paste image"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="Gray"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="4" Margin="0,0,0,12">
            <Button Width="85" Height="30" Margin="0,0,8,6" Content="Add row" Click="AddRow_Click" />
            <Button Width="105" Height="30" Margin="0,0,8,6" Content="Delete selected" Click="DeleteSelected_Click" />
            <Button Width="85" Height="30" Margin="0,0,8,6" Content="Swap X/Y" Click="SwapXY_Click" />
            <Button Width="85" Height="30" Margin="0,0,8,6" Content="Move up" Click="MoveUp_Click" ToolTip="Move selected rows up. Current visible order becomes the manual order; sorting is cleared. Point numbers stay unchanged." />
            <Button Width="85" Height="30" Margin="0,0,16,6" Content="Move down" Click="MoveDown_Click" ToolTip="Move selected rows down. Current visible order becomes the manual order; sorting is cleared. Point numbers stay unchanged." />
            <TextBlock VerticalAlignment="Center" Text="Start number:" Margin="0,0,6,6" />
            <TextBox x:Name="StartNumberTextBox" Width="60" Height="26" Text="1" Margin="0,0,16,6" VerticalContentAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="Text height:" Margin="0,0,6,6" />
            <TextBox x:Name="TextHeightTextBox" Width="65" Height="26" Text="2.5" Margin="0,0,0,6" VerticalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=CreateLabelsCheckBox}" />
        </WrapPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10">
                <TextBlock Text="Create:" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox x:Name="CreatePointsCheckBox" Content="Points" IsChecked="True" Margin="0,0,18,0" ToolTip="Create point entities on the Points layer." />
                <CheckBox x:Name="CreateLabelsCheckBox" Content="Labels" IsChecked="True" Margin="0,0,18,0" ToolTip="Create point-number text on the Labels layer. All Point numbers must be filled." />
                <CheckBox x:Name="CreateContourCheckBox" Content="Polyline" IsChecked="False" Margin="0,0,18,0" ToolTip="Create a polyline on the Polyline layer in displayed row order. Equal Z: 2D at that elevation; different Z: 3D." />
                <CheckBox x:Name="CloseContourCheckBox" Content="Closed" IsChecked="True" IsEnabled="{Binding IsChecked, ElementName=CreateContourCheckBox}" ToolTip="Checked: connect last vertex to first (at least 3 distinct positions). Unchecked: open polyline (at least 2)." />
            </WrapPanel>
            <Button Grid.Row="1" Grid.Column="0" Width="150" Height="36" Margin="0,0,8,0" Content="Create objects" Click="CreatePoints_Click" />
            <Button Grid.Row="1" Grid.Column="1" Width="120" Height="36" Content="Export CSV" Click="ExportCsv_Click" />
            <Button Grid.Row="1" Grid.Column="2" Width="165" Height="36" HorizontalAlignment="Left" Margin="8,0,0,0" Content="Renumber from Start" Click="Renumber_Click" ToolTip="Replace ALL point numbers in current displayed row order, starting at Start number" />
            <Button Grid.Row="1" Grid.Column="3" Width="90" Height="36" Content="Close" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
