<Window x:Class="OCR2Geometry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR2Geometry for AutoCAD"
        Height="700"
        Width="1060"
        MinHeight="620"
        MinWidth="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="OCR2Geometry"
                   FontSize="26"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Text="AutoCAD 2020 — local OCR v0.4.1 (no Python)"
                   Foreground="Gray" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="120" Height="32" Margin="0,0,8,0"
                        Content="Select image" Click="SelectImage_Click" />
                <Button Grid.Column="1" Width="120" Height="32" Margin="0,0,8,0"
                        Content="Paste image" Click="PasteImage_Click" />
                <TextBox Grid.Column="2" x:Name="SelectedImageTextBox" Height="28"
                         IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="3" Width="110" Height="32" Margin="0,0,8,0"
                        Content="Preview image" Click="PreviewImage_Click" IsEnabled="False" x:Name="PreviewImageButton" />
                <Button Grid.Column="4" Width="120" Height="32"
                        Content="Recognize OCR" Click="RecognizeImage_Click" IsEnabled="False" x:Name="RecognizeImageButton" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="150" Height="32" Margin="0,0,8,0" Content="Paste coordinates" Click="PasteCoordinates_Click" />
                <Button Grid.Column="1" Width="120" Height="32" Margin="0,0,8,0" Content="Import CSV/TXT" Click="ImportTextFile_Click" />
                <Button Grid.Column="2" Width="90" Height="32" Content="Clear table" Click="ClearTable_Click" />
                <TextBlock Grid.Column="4" x:Name="ImportStatusText" VerticalAlignment="Center" Foreground="Gray" Text="Ready" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PointsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CellEditEnding="PointsGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Point" Binding="{Binding Number}" Width="85" IsReadOnly="True" />

                    <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsXRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Запятая восстановлена автоматически. Проверьте значение." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsYRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Запятая восстановлена автоматически. Проверьте значение." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Z" Binding="{Binding Z, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsZRecovered}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE58A" />
                                        <Setter Property="ToolTip" Value="Запятая восстановлена автоматически. Проверьте значение." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                <Grid>
                    <Image x:Name="ImagePreview" Stretch="Uniform" Margin="8" />
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Select an image or use Win+Shift+S, then Paste image"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="Gray"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="90" Height="30" Margin="0,0,8,0" Content="Add row" Click="AddRow_Click" />
            <Button Grid.Column="1" Width="110" Height="30" Margin="0,0,8,0" Content="Delete selected" Click="DeleteSelected_Click" />
            <Button Grid.Column="2" Width="90" Height="30" Content="Swap X/Y" Click="SwapXY_Click" />

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Start number:" Margin="0,0,6,0" />
            <TextBox x:Name="StartNumberTextBox" Grid.Column="5" Width="60" Height="26" Text="1" VerticalContentAlignment="Center" />

            <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="Text height:" Margin="0,0,6,0" />
            <TextBox x:Name="TextHeightTextBox" Grid.Column="8" Width="65" Height="26" Text="2.5" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="150" Height="36" Margin="0,0,8,0" Content="Create points" Click="CreatePoints_Click" />
            <Button Grid.Column="1" Width="120" Height="36" Content="Export CSV" Click="ExportCsv_Click" />
            <Button Grid.Column="3" Width="90" Height="36" Content="Close" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
